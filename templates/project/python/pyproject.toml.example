# pyproject.toml 模板（python 项目）
[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "<project-name>"
version = "0.1.0"
description = "<一句话描述>"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    # 例：requests>=2.31
]

[project.optional-dependencies]
dev = [
    "pytest>=7",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
